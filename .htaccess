Options -Indexes
DirectoryIndex index.php
# mod_dir would answer 301 /runtime -> /runtime/ before the rewrite below runs,
# and the real directory then has no index file (403). Keep URLs verbatim.
DirectorySlash Off
RewriteEngine On
RewriteBase /

# Never expose dotfiles, dumps, keys, logs or common probe scripts.
<FilesMatch "(^\.|\.env|\.git|composer\.(json|lock)|phpinfo\.php|info\.php|.*\.(log|sqlite|sqlite3|key|bak|ini|sh|pyc))$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header unset Server
</IfModule>

RewriteRule ^(app|storage|views|config\.local\.php)(/|$) - [F,L]

# /runtime is both a real directory and an app route. Without these two rules the
# "-d" check below serves the directory and Apache answers 403 (no index file).
RewriteRule ^runtime/?$ index.php [QSA,L]
RewriteRule ^runtime/.+ - [F,L]

# Static files live in public/ but the host may point DocumentRoot at the project root.
RewriteCond %{REQUEST_URI} !^/public/
RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
RewriteRule ^(.+)$ public/$1 [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^(.+)$ index.php/$1 [QSA,L]
RewriteRule ^$ index.php [QSA,L]
